// Define database connection via the `DATABASE_URL` env var
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Prisma Client generator (uses default output location)
generator client {
  provider = "prisma-client-js"
}

// NextAuth.js required models
model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  emailVerified DateTime?
  phone         String?
  image         String?
  qrCodeExpiryMinutes Int @default(60)
  autoPullQrEnabled Boolean @default(false)
  autoPullQrThreshold Float?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  accounts      Account[]
  sessions      Session[]
  points        Points?
  requests      Request[]      @relation("Requester")
  donations     Request[]      @relation("Donor")
  notifications Notification[]
  getCredential GetCredential?
  qrRequests    GetFulfillment[] @relation("GetFulfillmentRequester")
  qrDonations   GetFulfillment[] @relation("GetFulfillmentDonor")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Points model - one row per user
model Points {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Int      @default(0)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime  @updatedAt
}

// Request model
model Request {
  id             String   @id @default(cuid())
  requesterId    String
  donorId        String?
  location       String
  pointsRequested Int
  status         String   @default("pending") // pending, accepted, declined, completed
  inPersonAllowed Boolean @default(true)
  qrCodeAllowed   Boolean @default(false)
  selectedFulfillmentMode String? // in_person, qr_code
  completedAt    DateTime?
  completionReason String?
  message        String?
  requester      User     @relation("Requester", fields: [requesterId], references: [id])
  donor          User?    @relation("Donor", fields: [donorId], references: [id])
  getFulfillment GetFulfillment?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Notification model
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // "request_accepted", "request_declined", etc.
  message   String
  read      Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GetCredential {
  id                    String   @id @default(cuid())
  userId                String   @unique
  deviceId              String?
  encryptedPin          String?  @db.Text
  encryptedSessionToken String?  @db.Text
  sessionFingerprint    String?
  status                String   @default("linked") // linked, invalid
  linkedAt              DateTime @default(now())
  lastValidatedAt       DateTime?
  invalidatedAt         DateTime?
  lastErrorCode         String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GetFulfillment {
  id                 String   @id @default(cuid())
  requestId          String   @unique
  requesterId        String
  donorId            String
  status             String   @default("active") // active, completed, unavailable, expired
  issuedAt           DateTime @default(now())
  expiresAt          DateTime
  baselineAccountsJson String? @db.Text
  completedAt        DateTime?
  completionReason   String?
  completionDelta    Float?
  lastCheckedAt      DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requester User    @relation("GetFulfillmentRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  donor     User    @relation("GetFulfillmentDonor", fields: [donorId], references: [id], onDelete: Cascade)
}


